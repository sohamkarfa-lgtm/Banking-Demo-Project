  'demo_dbt_profile' as target_user

    FROM stg_accounts AS act
    LEFT JOIN seed_demo AS sat ON act.account_type = sat.cd_value 
    AND sat.cd_name = 'Account_Type'
)

SELECT * FROM logic
  
