#Customer Transactions & Balances#
SELECT
  COALESCE(t.customer_id, a.customer_id) AS customer_id,
  COALESCE(SUM(t.amount), 0) AS total_amount,
  COALESCE(SUM(a.balance), 0) AS total_balance
FROM
  banking_catalog.gold.transaction_fact t
    FULL OUTER JOIN banking_catalog.gold.account_dim a
      ON t.customer_id = a.customer_id
GROUP BY
  COALESCE(t.customer_id, a.customer_id)

#Daily Transaction Trends#
SELECT
  timestamp AS transaction_date,
  COUNT(*) AS transaction_count,
  SUM(amount) AS daily_revenue
FROM
  banking_catalog.gold.transaction_fact
GROUP BY
  timestamp
ORDER BY
  timestamp

